<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#080b18"><title>LaunchAI</title>
<style>
:root{--bg:#080b18;--panel:#121a31;--line:#293455;--muted:#a4afcc;--blue:#648cff;--violet:#a16cff}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 80% 0,#292052,transparent 38%),var(--bg);color:#f6f7ff;font-family:Inter,system-ui,Arial}button,input,textarea,select{font:inherit}button{cursor:pointer}.wrap{max-width:1120px;margin:auto;padding:0 20px}.top{height:70px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:#080b18ed;backdrop-filter:blur(15px);z-index:5}.brand{font-size:22px;font-weight:850;color:white;text-decoration:none}.logo{display:inline-grid;place-items:center;width:32px;height:32px;border-radius:10px;background:linear-gradient(135deg,var(--blue),var(--violet));margin-right:8px}.nav{display:flex;gap:22px;align-items:center}.nav a{color:var(--muted);text-decoration:none;font-size:14px}.btn{border:0;border-radius:12px;padding:12px 17px;background:linear-gradient(110deg,var(--blue),var(--violet));color:white;font-weight:750}.outline{background:#ffffff0b;border:1px solid var(--line)}.hero{padding:75px 0 60px;display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:center}.tag{display:inline-block;border:1px solid #718cff66;color:#c4ceff;background:#718cff15;padding:8px 12px;border-radius:30px;font-size:12px;font-weight:700}h1{font-size:clamp(42px,6vw,68px);line-height:1.04;letter-spacing:-3px;margin:20px 0}.grad{background:linear-gradient(90deg,#72d4ff,#ad8aff,#efaaff);color:transparent;background-clip:text}.lead{font-size:17px;line-height:1.7;color:var(--muted)}.actions{display:flex;gap:10px;flex-wrap:wrap;margin:25px 0}.mock,.card,.panel,.price{border:1px solid var(--line);background:linear-gradient(145deg,#ffffff10,#ffffff05);border-radius:18px;padding:20px}.mock{box-shadow:0 25px 70px #5368ff30}.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}.stat{background:#ffffff09;border:1px solid var(--line);padding:15px;border-radius:13px}.stat small,.muted{color:var(--muted)}.stat strong{display:block;font-size:25px;margin-top:7px}.section{padding:55px 0}.center{text-align:center;max-width:650px;margin:0 auto 28px}.center p{color:var(--muted);line-height:1.6}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.card h3{margin:8px 0}.card p{color:var(--muted);font-size:14px;line-height:1.6}.ico{font-size:25px}.steps,.prices{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.price strong{font-size:27px;display:block;margin:12px 0}.price p,.price li{color:var(--muted);font-size:13px;line-height:1.7}.featured{border-color:#9580ff;background:#887aff18}.cta{text-align:center;padding:38px;border:1px solid #667cff66;border-radius:20px;background:radial-gradient(ellipse at top,#6877ff38,transparent 65%),#141b32;margin:35px 0 60px}footer{border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:12px}.app{display:none;min-height:85vh}.layout{display:grid;grid-template-columns:210px 1fr}.side{padding:20px 10px;border-right:1px solid var(--line);background:#0a1020}.side button{display:block;width:100%;text-align:left;background:none;border:0;color:#b3bedb;padding:12px;border-radius:9px}.side button.active,.side button:hover{background:#718cff25;color:white}.main{padding:28px;max-width:950px;width:100%;margin:auto}.row{display:flex;justify-content:space-between;align-items:center;gap:12px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{margin:12px 0}.field label{display:block;font-size:12px;color:#b5c0df;margin-bottom:6px}.field input,.field textarea,.field select{width:100%;padding:12px;background:#090f20;border:1px solid var(--line);border-radius:9px;color:white}.field textarea{min-height:85px}.output{white-space:pre-wrap;line-height:1.6;padding:15px;border-radius:12px;background:#090f20;border:1px solid var(--line);min-height:80px}.hide{display:none!important}.mobile{display:none}
@media(max-width:700px){.wrap{padding:0 15px}.nav{display:none}.hero{grid-template-columns:1fr;padding:48px 0}.cards{grid-template-columns:1fr 1fr}.steps,.prices{grid-template-columns:1fr 1fr}.layout{grid-template-columns:1fr}.side{display:none}.main{padding:20px 14px 80px}.mobile{display:flex;position:fixed;bottom:0;left:0;right:0;justify-content:space-around;background:#0a1020;border-top:1px solid var(--line);padding:8px;z-index:8}.mobile button{background:none;border:0;color:#c4cce4;font-size:11px}.stats{grid-template-columns:1fr 1fr}}@media(max-width:420px){.cards{grid-template-columns:1fr}.prices{grid-template-columns:1fr}.hero h1{letter-spacing:-2px}}
</style></head><body>
<header class="top wrap"><a class="brand" href="#" onclick="landing();return false"><span class="logo">✦</span>LaunchAI</a><nav class="nav"><a href="#features">Features</a><a href="#how">How it works</a><a href="#pricing">Pricing</a><button class="btn" onclick="studio()">Open Studio ↗</button></nav><button class="btn" onclick="studio()" style="display:none" id="mobopen">Open Studio</button></header>
<div id="landing" class="wrap"><section class="hero"><div><span class="tag">✦ AI PRODUCT MARKETING WORKSPACE</span><h1>From product photo to <span class="grad">product launch.</span></h1><p class="lead">Create product marketing content in one workspace. Plan advertisements, write product descriptions and prepare social campaigns with AI-assisted tools.</p><div class="actions"><button class="btn" onclick="studio()">Start creating free →</button><a class="btn outline" href="#how" style="text-decoration:none">See how it works</a></div><small class="muted">For makers, manufacturers, ecommerce sellers and creators.</small></div><div class="mock"><div class="row"><b>✦ LaunchAI Studio</b><small class="muted">Workspace preview</small></div><div class="stats" style="margin-top:15px"><div class="stat"><small>Campaign drafts</small><strong>24</strong></div><div class="stat"><small>Creative ideas</small><strong>86</strong></div><div class="stat" style="grid-column:span 2"><small>Product launch workflow</small><div style="display:flex;gap:8px;margin-top:12px"><img alt="Cosmetic product" src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?w=300" style="width:31%;height:110px;object-fit:cover;border-radius:10px"><img alt="Sneaker" src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=300" style="width:31%;height:110px;object-fit:cover;border-radius:10px"><img alt="Perfume" src="https://images.unsplash.com/photo-1594035910387-fea47794261f?w=300" style="width:31%;height:110px;object-fit:cover;border-radius:10px"></div></div></div></div></section>
<section id="features" class="section"><div class="center"><span class="tag">ONE WORKSPACE · MANY POSSIBILITIES</span><h2>Everything you need to <span class="grad">launch smarter</span></h2><p>Bring product information together and turn it into a consistent marketing campaign.</p></div><div class="cards"><div class="card"><div class="ico">▧</div><h3>Product visuals</h3><p>Prepare creative concepts and product image briefs.</p></div><div class="card"><div class="ico">✧</div><h3>Ad creator</h3><p>Draft promotional concepts, headlines and campaign layouts.</p></div><div class="card"><div class="ico">✎</div><h3>AI copywriting</h3><p>Write product descriptions, captions and marketing messages.</p></div><div class="card"><div class="ico">◎</div><h3>Social content</h3><p>Prepare platform-specific posts for your product launch.</p></div><div class="card"><div class="ico">▶</div><h3>Video studio</h3><p>Plan promotional video scripts and storyboards.</p></div><div class="card"><div class="ico">▤</div><h3>Catalogue builder</h3><p>Organise product details into catalogue-ready content.</p></div></div></section>
<section id="how" class="section"><div class="center"><h2>From idea to <span class="grad">launch kit</span></h2><p>A simple four-step workflow.</p></div><div class="steps"><div class="card"><small>STEP 01</small><h3>Add product</h3><p>Enter name, category, price and details.</p></div><div class="card"><small>STEP 02</small><h3>Choose a goal</h3><p>Select a description, ad or social post.</p></div><div class="card"><small>STEP 03</small><h3>Generate & edit</h3><p>Review and refine the draft.</p></div><div class="card"><small>STEP 04</small><h3>Prepare to publish</h3><p>Copy your content and export your launch kit.</p></div></div></section>
<section id="pricing" class="section"><div class="center"><h2>Start small. <span class="grad">Grow with LaunchAI.</span></h2><p>Proposed prices only. Payments are not connected in this prototype.</p></div><div class="prices"><div class="price"><b>Free</b><strong>₹0</strong><p>Demo workspace<br>Basic content drafts</p><button class="btn outline" onclick="studio()">Try demo</button></div><div class="price"><b>Starter</b><strong>₹299<small>/mo</small></strong><p>Product copy tools<br>Campaign drafts</p><button class="btn outline" onclick="studio()">Explore</button></div><div class="price featured"><b>Creator · Popular</b><strong>₹799<small>/mo</small></strong><p>Creative workflows<br>Brand kit workspace</p><button class="btn" onclick="studio()">Explore</button></div><div class="price"><b>Business</b><strong>₹1,499<small>/mo</small></strong><p>Multiple brand profiles<br>Team-ready workspace</p><button class="btn outline" onclick="studio()">Explore</button></div></div></section><div class="cta"><h2>Make your next product launch count.</h2><p class="muted">Bring your product details. We'll help you shape the marketing.</p><button class="btn" onclick="studio()">Open LaunchAI Studio →</button></div></div>
<div id="app" class="app"><div class="layout"><aside class="side"><p class="muted">WORKSPACE</p><button data-v="home" class="active">◫ Overview</button><button data-v="products">▧ My Products</button><p class="muted">AI TOOLS</p><button data-v="copy">✎ Copywriting Studio</button><button data-v="ads">✧ Advertisement Creator</button><button data-v="social">◎ Social Media Studio</button><button data-v="video">▶ Video Storyboard</button><p class="muted">ACCOUNT</p><button data-v="plans">◇ Plans & Credits</button><button onclick="landing()">↗ View website</button></aside><main class="main">
<div id="v-home"><div class="row"><div><h2>Welcome to your studio ✦</h2><p class="muted">Your product marketing workspace is ready.</p></div><button class="btn" onclick="view('products')">+ Add product</button></div><div class="stats" style="margin:20px 0"><div class="stat"><small>Products</small><strong id="count">0</strong></div><div class="stat"><small>Demo credits</small><strong>12</strong></div></div><div class="panel"><h3>Quick start</h3><div class="grid2"><button class="btn outline" onclick="view('products')">▧ Add a product</button><button class="btn outline" onclick="view('copy')">✎ Write product copy</button><button class="btn outline" onclick="view('ads')">✧ Plan an advertisement</button><button class="btn outline" onclick="view('social')">◎ Create social post</button></div></div><p class="muted">Demo mode: sample tools only. Real AI APIs are not connected.</p></div>
<div id="v-products" class="hide"><h2>My Products</h2><div class="panel"><h3>Add a product</h3><form id="pf"><div class="field"><label>Product name *</label><input id="pn" required placeholder="e.g. Glow Serum"></div><div class="field"><label>Category</label><select id="pc"><option>Beauty & skincare</option><option>Food & beverage</option><option>Fashion</option><option>Electronics</option><option>Home & living</option><option>Other</option></select></div><div class="field"><label>Price</label><input id="pp" placeholder="e.g. ₹499"></div><div class="field"><label>Description</label><textarea id="pd" placeholder="Describe your product accurately"></textarea></div><button class="btn">Save product</button></form></div><div class="panel"><h3>Saved products</h3><div id="plist" class="muted">No products yet.</div></div></div>
<div id="v-copy" class="hide"><h2>Copywriting Studio</h2><div class="panel"><div class="field"><label>Product</label><select id="cp"></select></div><div class="field"><label>Content type</label><select id="ct"><option>Product description</option><option>Instagram caption</option><option>SEO title</option><option>Ad headline</option><option>Launch announcement</option></select></div><button class="btn" onclick="copygen()">Create draft ✦</button></div><div class="panel"><h3>Draft</h3><div id="co" class="output">Your draft appears here.</div><button class="btn outline" onclick="copy('co')">Copy</button></div></div>
<div id="v-ads" class="hide"><h2>Advertisement Creator</h2><div class="panel"><div class="field"><label>Product</label><select id="ap"></select></div><div class="field"><label>Campaign goal</label><select id="ag"><option>Product launch</option><option>Promote an offer</option><option>Brand awareness</option></select></div><div class="field"><label>Key message</label><textarea id="am" placeholder="What should customers know?"></textarea></div><button class="btn" onclick="adgen()">Create ad concept ✦</button></div><div class="panel"><div id="ao" class="output">Your ad concept appears here.</div><button class="btn outline" onclick="copy('ao')">Copy</button></div></div>
<div id="v-social" class="hide"><h2>Social Media Studio</h2><div class="panel"><div class="field"><label>Product</label><select id="sp"></select></div><div class="field"><label>Platform</label><select id="platform"><option>Instagram</option><option>Facebook</option><option>LinkedIn</option><option>TikTok</option><option>YouTube</option></select></div><button class="btn" onclick="socialgen()">Create social post ✦</button></div><div class="panel"><div id="so" class="output">Your post appears here.</div><button class="btn outline" onclick="copy('so')">Copy</button></div></div>
<div id="v-video" class="hide"><h2>Video Storyboard</h2><div class="panel"><div class="field"><label>Product</label><select id="vp"></select></div><div class="field"><label>Style</label><select id="vs"><option>Product showcase</option><option>Unboxing</option><option>Brand story</option></select></div><button class="btn" onclick="videogen()">Create storyboard ✦</button></div><div class="panel"><div id="vo" class="output">Your storyboard appears here.</div></div></div>
<div id="v-plans" class="hide"><h2>Plans & Credits</h2><div class="prices"><div class="price">Free<strong>₹0</strong></div><div class="price">Starter<strong>₹299</strong></div><div class="price featured">Creator<strong>₹799</strong></div><div class="price">Business<strong>₹1,499</strong></div></div><p class="muted">Prices are illustrative. Payment processing is not active.</p></div>
</main></div><div class="mobile"><button onclick="view('home')">⌂<br>Home</button><button onclick="view('products')">▧<br>Products</button><button onclick="view('copy')">✎<br>Copy</button><button onclick="view('ads')">✧<br>Ads</button><button onclick="view('plans')">◇<br>Plans</button></div></div>
<footer class="wrap">© 2026 LaunchAI · Prototype demo · AI services and payments are not connected.</footer>
<script>
let ps=JSON.parse(localStorage.getItem('lai-products')||'[]');function studio(){document.getElementById('landing').style.display='none';document.getElementById('app').style.display='block';window.scrollTo(0,0);render();view('home')}function landing(){document.getElementById('app').style.display='none';document.getElementById('landing').style.display='block';window.scrollTo(0,0)}function view(v){['home','products','copy','ads','social','video','plans'].forEach(x=>document.getElementById('v-'+x).classList.toggle('hide',x!==v));document.querySelectorAll('.side button[data-v]').forEach(b=>b.classList.toggle('active',b.dataset.v===v));window.scrollTo(0,0)}document.querySelectorAll('.side button[data-v]').forEach(b=>b.onclick=()=>view(b.dataset.v));function safe(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function render(){document.getElementById('count').textContent=ps.length;document.getElementById('plist').innerHTML=ps.length?ps.map(p=>'<div class="output" style="margin:8px 0"><b>'+safe(p.n)+'</b><br>'+safe(p.c)+' · '+safe(p.p)+'<br>'+safe(p.d)+'</div>').join(''):'No products yet.';['cp','ap','sp','vp'].forEach(id=>document.getElementById(id).innerHTML=ps.length?ps.map((p,i)=>'<option value="'+i+'">'+safe(p.n)+'</option>').join(''):'<option value="">Add a product first</option>')}document.getElementById('pf').onsubmit=e=>{e.preventDefault();ps.push({n:pn.value,c:pc.value,p:pp.value,d:pd.value});localStorage.setItem('lai-products',JSON.stringify(ps));e.target.reset();render();alert('Product saved in this browser.')};function sel(id){return ps[Number(document.getElementById(id).value)]||{n:'Your product',d:'Add product details first.',p:''}}function copygen(){let p=sel('cp');co.textContent=ct.value+' — DRAFT\n\nMeet '+p.n+'. '+(p.d||'Discover the product and explore its features.')+'\n\nLearn more about '+p.n+'. '+(p.p?'Price: '+p.p+'.':'')+'\n\nDemo draft. Verify all product claims before publishing.'}function adgen(){let p=sel('ap');ao.textContent='CAMPAIGN: '+ag.value+'\n\nHeadline: Introducing '+p.n+'\n\nKey message: '+(am.value||p.d||'Present the confirmed product benefits.')+'\n\nVisual direction: Clean product hero image, clear headline, concise copy and one call-to-action.\n\nDemo concept only.'}function socialgen(){let p=sel('sp');so.textContent=platform.value+' POST\n\nIntroducing '+p.n+' ✨\n'+(p.d||'Discover the details and explore the product.')+'\n\nLearn more today.\n#ProductLaunch #NewProduct #SmallBusiness\n\nDemo draft; verify details before publishing.'}function videogen(){let p=sel('vp');vo.textContent=vs.value+' STORYBOARD\n\n0–3 sec: Product hero shot.\n3–7 sec: Show product details.\n7–12 sec: Present one confirmed feature.\n12–15 sec: Product name and call to action.\n\nVoiceover draft: “Meet '+p.n+'. Discover more today.”\n\nStoryboard only; video rendering is not connected.'}function copy(id){let t=document.getElementById(id).textContent;if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(t).then(()=>alert('Copied')).catch(()=>alert('Please select and copy the text manually.'));else alert('Please select and copy the text manually.')}
</script></body></html>
